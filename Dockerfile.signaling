FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV SIGNALING_PORT=3001

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY core/protocol.ts ./core/protocol.ts

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 slate \
  && chown -R slate:nodejs /app

USER slate

EXPOSE 3001

CMD ["node", "server/signaling.ts"]
